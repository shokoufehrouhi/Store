generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model addresses {
  id          Int       @id @default(autoincrement())
  customer_id Int
  recipient   String    @db.VarChar(120)
  phone       String    @db.VarChar(20)
  city        String    @db.VarChar(80)
  province    String?   @db.VarChar(80)
  postal_code String?   @db.VarChar(15)
  detail      String
  is_default  Boolean   @default(false)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders      orders[]

  @@index([customer_id], map: "idx_addresses_customer")
}

model categories {
  id            Int             @id @default(autoincrement())
  key           String          @unique @db.VarChar(60)
  label_fa      String          @db.VarChar(60)
  label_en      String          @db.VarChar(60)
  label_tr      String          @db.VarChar(60)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  products      products[]
  subcategories subcategories[]
}

model colors {
  id                Int                 @id @default(autoincrement())
  key               String              @unique @db.VarChar(20)
  hex               String              @db.Char(7)
  name_fa           String              @db.VarChar(30)
  name_en           String              @db.VarChar(30)
  name_tr           String              @db.VarChar(30)
  order_items       order_items[]
  product_colors    product_colors[]
  product_inventory product_inventory[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customers {
  id             Int         @id @default(autoincrement())
  full_name      String      @db.VarChar(120)
  email          String?     @unique @db.VarChar(160)
  mobile         String?     @unique @db.VarChar(20)
  password_hash  String      @db.VarChar(200)
  preferred_lang      String      @default("fa") @db.Char(2)
  is_active           Boolean     @default(true)
  reset_token         String?     @db.VarChar(64)
  reset_token_expires DateTime?   @db.Timestamptz(6)
  created_at          DateTime    @default(now()) @db.Timestamptz(6)
  updated_at          DateTime    @default(now()) @db.Timestamptz(6)
  registered_by       String?     @db.Char(1)
  addresses           addresses[]
  orders              orders[]
  sessions            sessions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  id         Int      @id @default(autoincrement())
  order_id   Int
  product_id Int
  color_id   Int?
  size_label String?  @db.VarChar(10)
  qty        Int      @default(1) @db.SmallInt
  unit_price Decimal  @default(0) @db.Decimal(12, 0)
  colors     colors?  @relation(fields: [color_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders     orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products   products @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([order_id, product_id, color_id, size_label])
  @@index([order_id], map: "idx_order_items_order")
  @@index([product_id], map: "idx_order_items_product")
}

model orders {
  id                       Int           @id @default(autoincrement())
  customer_id              Int
  address_id               Int?
  status                   order_status  @default(pending)
  channel                  String        @default("whatsapp") @db.VarChar(20)
  note                     String?
  total_amount             Decimal       @default(0) @db.Decimal(14, 0)
  tracking_code            String?       @unique @db.VarChar(40)
  created_at               DateTime      @default(now()) @db.Timestamptz(6)
  updated_at               DateTime      @default(now()) @db.Timestamptz(6)
  iban                     String?       @db.VarChar(40)
  bank_name                String?       @db.VarChar(60)
  account_holder           String?       @db.VarChar(120)
  payment_receipt_url      String?       @db.VarChar(300)
  payment_rejection_reason String?
  carrier_name             String?       @db.VarChar(60)
  tracking_number          String?       @db.VarChar(60)
  shipped_at               DateTime?     @db.Timestamptz(6)
  delivered_at             DateTime?     @db.Timestamptz(6)
  order_items              order_items[]
  addresses                addresses?    @relation(fields: [address_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers                customers     @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments                 payments[]

  @@index([customer_id], map: "idx_orders_customer")
  @@index([status], map: "idx_orders_status")
}

model payments {
  id              Int            @id @default(autoincrement())
  order_id        Int
  method          payment_method
  status          payment_status @default(pending)
  amount          Decimal        @db.Decimal(14, 0)
  transaction_ref String?        @db.VarChar(100)
  paid_at         DateTime?      @db.Timestamptz(6)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  orders          orders         @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id], map: "idx_payments_order")
}

model product_colors {
  product_id   Int
  color_id     Int
  is_available Boolean  @default(true)
  colors       colors   @relation(fields: [color_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products     products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, color_id])
}

model product_sizes {
  id           Int      @id @default(autoincrement())
  product_id   Int
  size_label   String   @db.VarChar(10)
  is_available Boolean  @default(true)
  products     products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, size_label])
}

model products {
  id                Int                 @id @default(autoincrement())
  category_id       Int
  subcategory_id    Int?
  gender            gender_type         @default(unisex)
  name_fa           String              @db.VarChar(120)
  name_en           String              @db.VarChar(120)
  name_tr           String              @db.VarChar(120)
  desc_fa           String?
  desc_en           String?
  desc_tr           String?
  emoji             String?             @db.VarChar(10)
  gradient          String?             @db.VarChar(200)
  tag               product_tag?
  price             Decimal             @default(0) @db.Decimal(12, 0)
  stock             Int                 @default(0)
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  delivery_days     Int                 @default(5)
  code              String?             @unique @db.VarChar(40)
  order_items       order_items[]
  product_colors    product_colors[]
  product_inventory product_inventory[]
  product_media     product_media[]
  product_sizes     product_sizes[]
  categories        categories          @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subcategories     subcategories?      @relation(fields: [subcategory_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([is_active], map: "idx_products_active")
  @@index([category_id], map: "idx_products_category")
  @@index([subcategory_id], map: "idx_products_subcategory")
}

model product_media {
  id         Int       @id @default(autoincrement())
  product_id Int
  type       String    @db.VarChar(10)
  url        String
  sort_order Int?      @default(0) @db.SmallInt
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_media_product")
}

model sizes {
  id         Int    @id @default(autoincrement())
  label      String @unique @db.VarChar(20)
  sort_order Int    @default(0) @db.SmallInt
}

model sessions {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id   Int
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  last_activity DateTime  @default(now()) @db.Timestamptz(6)
  expires_at    DateTime  @default(dbgenerated("(now() + '00:30:00'::interval)")) @db.Timestamptz(6)
  is_active     Boolean   @default(true)
  customers     customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_active, expires_at], map: "idx_sessions_active")
  @@index([customer_id], map: "idx_sessions_customer")
}

model subcategories {
  id          Int        @id @default(autoincrement())
  category_id Int
  key         String     @db.VarChar(30)
  label_fa    String     @db.VarChar(60)
  label_en    String     @db.VarChar(60)
  label_tr    String     @db.VarChar(60)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  products    products[]
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([category_id, key])
}

model product_inventory {
  id         Int      @id @default(autoincrement())
  product_id Int
  color_id   Int?
  size_label String?  @db.VarChar(10)
  quantity   Int      @default(0)
  colors     colors?  @relation(fields: [color_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, color_id, size_label])
  @@index([product_id], map: "idx_product_inventory_product")
}

enum gender_type {
  male
  female
  unisex
}

enum order_status {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  returned
  preorder
  payment_needed
  approval_needed
  preparing
  delivery
}

enum payment_method {
  whatsapp_order
  telegram_order
  cash_on_delivery
  card
  transfer
}

enum payment_status {
  pending
  paid
  failed
  refunded
}

enum product_tag {
  bestseller
  new
}
