generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model addresses {
  id          Int       @id @default(autoincrement())
  customer_id Int
  recipient   String    @db.VarChar(120)
  phone       String    @db.VarChar(20)
  city        String    @db.VarChar(80)
  province    String?   @db.VarChar(80)
  postal_code String?   @db.VarChar(15)
  detail      String
  is_default  Boolean   @default(false)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders      orders[]

  @@index([customer_id], map: "idx_addresses_customer")
}

model categories {
  id            Int             @id @default(autoincrement())
  key           String          @unique @db.VarChar(60)
  label_fa      String          @db.VarChar(60)
  label_en      String          @db.VarChar(60)
  label_tr      String          @db.VarChar(60)
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  products           products[]
  subcategories      subcategories[]
  product_categories product_categories[]
}

model colors {
  id                Int                 @id @default(autoincrement())
  key               String              @unique @db.VarChar(20)
  hex               String              @db.Char(7)
  name_fa           String              @db.VarChar(30)
  name_en           String              @db.VarChar(30)
  name_tr           String              @db.VarChar(30)
  order_items       order_items[]
  product_colors    product_colors[]
  product_inventory product_inventory[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customers {
  id             Int         @id @default(autoincrement())
  full_name      String      @db.VarChar(120)
  email          String?     @unique @db.VarChar(160)
  mobile         String?     @unique @db.VarChar(20)
  password_hash  String      @db.VarChar(200)
  preferred_lang      String      @default("fa") @db.Char(2)
  is_active           Boolean     @default(true)
  reset_token         String?     @db.VarChar(64)
  reset_token_expires DateTime?   @db.Timestamptz(6)
  created_at          DateTime    @default(now()) @db.Timestamptz(6)
  updated_at          DateTime    @default(now()) @db.Timestamptz(6)
  registered_by       String?     @db.Char(1)
  avatar                  String?
  birth_date              DateTime?   @db.Date
  gender                  String?     @db.VarChar(10)
  birthday_email_year     Int?
  birthday_email_sent_at  DateTime?
  addresses           addresses[]
  orders              orders[]
  sessions            sessions[]
  customer_favorites      customer_favorites[]
  cart_items              cart_items[]
  coupon_assignments      coupon_assignments[]
  customer_product_photos customer_product_photos[]
  leads                   leads[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  id         Int      @id @default(autoincrement())
  order_id   Int
  product_id Int
  color_id   Int?
  size_label String?  @db.VarChar(10)
  qty        Int      @default(1) @db.SmallInt
  unit_price Decimal  @default(0) @db.Decimal(12, 2)
  colors     colors?  @relation(fields: [color_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders     orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products   products @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([order_id, product_id, color_id, size_label])
  @@index([order_id], map: "idx_order_items_order")
  @@index([product_id], map: "idx_order_items_product")
}

model orders {
  id                       Int           @id @default(autoincrement())
  customer_id              Int
  address_id               Int?
  status                   order_status  @default(pending)
  channel                  String        @default("whatsapp") @db.VarChar(20)
  note                     String?
  lang                     String        @default("fa") @db.Char(2)
  total_amount             Decimal       @default(0) @db.Decimal(14, 0)
  tracking_code            String?       @unique @db.VarChar(40)
  created_at               DateTime      @default(now()) @db.Timestamptz(6)
  updated_at               DateTime      @default(now()) @db.Timestamptz(6)
  iban                     String?       @db.VarChar(40)
  bank_name                String?       @db.VarChar(60)
  account_holder           String?       @db.VarChar(120)
  payment_receipt_url      String?       @db.VarChar(300)
  payment_rejection_reason String?
  carrier_name             String?       @db.VarChar(60)
  tracking_number          String?       @db.VarChar(60)
  shipped_at               DateTime?     @db.Timestamptz(6)
  delivered_at             DateTime?     @db.Timestamptz(6)
  rejected_at              DateTime?     @db.Timestamptz(6)
  is_prize                 Boolean       @default(false)
  admin_note               String?
  tracking_note            String?
  coupon_code              String?       @db.VarChar(50)
  discount_amount          Decimal       @default(0) @db.Decimal(14, 0)
  original_amount          Decimal?      @db.Decimal(14, 0)
  order_items              order_items[]
  order_messages           order_messages[]
  order_returns            order_returns[]
  customer_product_photos  customer_product_photos[]
  addresses                addresses?    @relation(fields: [address_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers                customers     @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments                 payments[]

  @@index([customer_id], map: "idx_orders_customer")
  @@index([status], map: "idx_orders_status")
}

model order_messages {
  id           Int      @id @default(autoincrement())
  order_id     Int
  sender       String   @db.VarChar(10)
  message      String
  order_status String   @db.VarChar(30)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  orders       orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id], map: "idx_order_messages_order")
}

model order_returns {
  id                   Int       @id @default(autoincrement())
  order_id             Int
  type                 String    @default("return") @db.VarChar(20)
  status               String    @default("requested") @db.VarChar(30)
  return_code          String?   @unique @db.VarChar(20)
  carrier_name         String?   @db.VarChar(60)
  carrier_tracking     String?   @db.VarChar(80)
  shipping_receipt_url String?   @db.VarChar(300)
  shipped_at           DateTime? @db.Timestamptz(6)
  deadline_at          DateTime? @db.Timestamptz(6)
  received_at          DateTime? @db.Timestamptz(6)
  refund_iban          String?   @db.VarChar(40)
  refund_holder        String?   @db.VarChar(120)
  refund_receipt_url   String?   @db.VarChar(300)
  refund_sent_at       DateTime? @db.Timestamptz(6)
  completed_at         DateTime? @db.Timestamptz(6)
  defective_note       String?
  defective_photo_url  String?   @db.VarChar(300)
  rejection_reason     String?   @db.VarChar(30)
  rejection_note       String?
  rejection_photo_url  String?   @db.VarChar(300)
  rejected_at          DateTime? @db.Timestamptz(6)
  requested_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @db.Timestamptz(6)
  orders               orders    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id], map: "idx_order_returns_order")
}

model coupons {
  id             Int       @id @default(autoincrement())
  code           String    @unique @db.VarChar(50)
  type           String    @db.VarChar(10)
  value          Decimal   @db.Decimal(10, 2)
  for_all        Boolean   @default(true)
  max_uses       Int?
  used_count     Int       @default(0)
  is_active      Boolean   @default(true)
  is_protected      Boolean   @default(false)
  description       String?   @db.Text
  min_orders        Int?
  first_order_only  Boolean   @default(false)
  show_banner       Boolean   @default(false)
  banner_text_fa String?   @db.VarChar(200)
  banner_text_en String?   @db.VarChar(200)
  banner_text_tr String?   @db.VarChar(200)
  starts_at      DateTime? @db.Timestamptz(6)
  expires_at     DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)
  coupon_assignments coupon_assignments[]
}

model leads {
  id                      Int       @id @default(autoincrement())
  name                    String?   @db.VarChar(100)
  email                   String    @db.VarChar(200)
  phone                   String?   @db.VarChar(30)
  referred_by_customer_id Int?
  referred_by_order_id    Int?
  status                  String    @default("pending") @db.VarChar(20)
  tracking_token          String    @unique @db.VarChar(64)
  coupon_assigned         Boolean   @default(false)
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  customers               customers? @relation(fields: [referred_by_customer_id], references: [id])
}

model coupon_assignments {
  id          Int       @id @default(autoincrement())
  coupon_id   Int
  customer_id Int
  coupons     coupons   @relation(fields: [coupon_id], references: [id], onDelete: Cascade)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@unique([coupon_id, customer_id])
}

model payments {
  id              Int            @id @default(autoincrement())
  order_id        Int
  method          payment_method
  status          payment_status @default(pending)
  amount          Decimal        @db.Decimal(14, 0)
  transaction_ref String?        @db.VarChar(100)
  paid_at         DateTime?      @db.Timestamptz(6)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  orders          orders         @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id], map: "idx_payments_order")
}

model product_colors {
  product_id   Int
  color_id     Int
  is_available Boolean  @default(true)
  colors       colors   @relation(fields: [color_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products     products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, color_id])
}

model product_sizes {
  id           Int      @id @default(autoincrement())
  product_id   Int
  size_label   String   @db.VarChar(10)
  is_available Boolean  @default(true)
  products     products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, size_label])
}

model products {
  id                Int                 @id @default(autoincrement())
  category_id       Int
  subcategory_id    Int?
  gender            gender_type         @default(unisex)
  name_fa           String              @db.VarChar(120)
  name_en           String              @db.VarChar(120)
  name_tr           String              @db.VarChar(120)
  desc_fa           String?
  desc_en           String?
  desc_tr           String?
  emoji             String?             @db.VarChar(10)
  gradient          String?             @db.VarChar(200)
  tag               product_tag?
  price             Decimal             @default(0) @db.Decimal(12, 2)
  discounted_price  Decimal?            @db.Decimal(12, 2)
  cost_price        Decimal?            @db.Decimal(12, 2)
  stock             Int                 @default(0)
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  delivery_days       Int                 @default(5)
  code                String?             @unique @db.VarChar(40)
  brand               String?             @db.VarChar(120)
  supplier_shop_name  String?             @db.VarChar(120)
  product_link        String?             @db.VarChar(500)
  supplier_code       String?             @db.VarChar(120)
  supplier_note       String?
  order_items         order_items[]
  product_colors     product_colors[]
  product_inventory  product_inventory[]
  product_media      product_media[]
  product_sizes      product_sizes[]
  product_categories product_categories[]
  categories         categories          @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subcategories      subcategories?      @relation(fields: [subcategory_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([is_active], map: "idx_products_active")
  @@index([category_id], map: "idx_products_category")
  @@index([subcategory_id], map: "idx_products_subcategory")
  customer_favorites       customer_favorites[]
  cart_items               cart_items[]
  customer_product_photos  customer_product_photos[]
}

model product_media {
  id         Int       @id @default(autoincrement())
  product_id Int
  type       String    @db.VarChar(10)
  url        String
  sort_order Int?      @default(0) @db.SmallInt
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_media_product")
}

model sizes {
  id         Int    @id @default(autoincrement())
  label      String @unique @db.VarChar(20)
  sort_order Int    @default(0) @db.SmallInt
}

model sessions {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id   Int
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  last_activity DateTime  @default(now()) @db.Timestamptz(6)
  expires_at    DateTime  @default(dbgenerated("(now() + '00:30:00'::interval)")) @db.Timestamptz(6)
  is_active     Boolean   @default(true)
  customers     customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_active, expires_at], map: "idx_sessions_active")
  @@index([customer_id], map: "idx_sessions_customer")
}

model subcategories {
  id          Int        @id @default(autoincrement())
  category_id Int
  key         String     @db.VarChar(30)
  label_fa    String     @db.VarChar(60)
  label_en    String     @db.VarChar(60)
  label_tr    String     @db.VarChar(60)
  is_active   Boolean    @default(true)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  products           products[]
  categories         categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_categories product_categories[]

  @@unique([category_id, key])
}

model cart_items {
  id          Int       @id @default(autoincrement())
  customer_id Int
  product_id  Int
  color_key   String?   @db.VarChar(20)
  size_label  String?   @db.VarChar(10)
  qty         Int       @default(1) @db.SmallInt
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([customer_id, product_id, color_key, size_label])
  @@index([customer_id], map: "idx_cart_items_customer")
}

model customer_favorites {
  customer_id Int
  product_id  Int
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([customer_id, product_id])
  @@index([customer_id], map: "idx_customer_favorites_customer")
}

model product_inventory {
  id         Int      @id @default(autoincrement())
  product_id Int
  color_id   Int?
  size_label String?  @db.VarChar(10)
  quantity   Int      @default(0)
  colors     colors?  @relation(fields: [color_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, color_id, size_label])
  @@index([product_id], map: "idx_product_inventory_product")
}

model bank_accounts {
  id             Int      @id @default(autoincrement())
  bank_name      String   @db.VarChar(60)
  account_holder String   @db.VarChar(120)
  iban           String   @db.VarChar(40)
  is_active      Boolean  @default(true)
  sort_order     Int      @default(0) @db.SmallInt
  created_at     DateTime @default(now()) @db.Timestamptz(6)
}

enum gender_type {
  male
  female
  unisex
}

enum order_status {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  rejected
  returned
  preorder
  payment_needed
  approval_needed
  preparing
  delivery
}

enum payment_method {
  whatsapp_order
  telegram_order
  cash_on_delivery
  card
  transfer
}

enum payment_status {
  pending
  paid
  failed
  refunded
}

enum product_tag {
  bestseller
  new
}

model customer_product_photos {
  id          Int       @id @default(autoincrement())
  product_id  Int
  customer_id Int
  order_id    Int
  photo_url   String    @db.VarChar(300)
  is_approved Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  products    products  @relation(fields: [product_id],  references: [id], onDelete: Cascade)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  orders      orders    @relation(fields: [order_id],    references: [id], onDelete: Cascade)

  @@index([product_id, is_approved], map: "idx_cpp_product")
}

model suppliers {
  id             Int       @id @default(autoincrement())
  shop_name      String    @db.VarChar(150)
  supplier_name  String?   @db.VarChar(150)
  phone          String?   @db.VarChar(30)
  telegram       String?   @db.VarChar(120)
  website        String?   @db.VarChar(300)
  instagram      String?   @db.VarChar(120)
  store_address  String?
  card_photo_url String?   @db.VarChar(300)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)
}

model product_categories {
  id             Int            @id @default(autoincrement())
  product_id     Int
  category_id    Int
  subcategory_id Int?
  products       products       @relation(fields: [product_id],     references: [id], onDelete: Cascade)
  categories     categories     @relation(fields: [category_id],    references: [id], onDelete: Cascade)
  subcategories  subcategories? @relation(fields: [subcategory_id], references: [id], onDelete: Cascade)

  @@unique([product_id, category_id, subcategory_id])
  @@index([product_id], map: "idx_product_categories_product")
}
